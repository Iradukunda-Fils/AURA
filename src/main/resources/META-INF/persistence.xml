<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_2.xsd"
             version="3.2">
    <persistence-unit name="default" transaction-type="RESOURCE_LOCAL">
        <provider>org.hibernate.jpa.HibernatePersistenceProvider</provider>
        <class>rw.ac.auca.aura.infrastructure.persistence.entities.SiteEntity</class>
        <class>rw.ac.auca.aura.infrastructure.persistence.entities.BuildingEntity</class>
        <class>rw.ac.auca.aura.infrastructure.persistence.entities.DepartmentEntity</class>
        <class>rw.ac.auca.aura.infrastructure.persistence.entities.ProgramEntity</class>
        <class>rw.ac.auca.aura.infrastructure.persistence.entities.CourseEntity</class>
        <class>rw.ac.auca.aura.infrastructure.persistence.entities.LecturerEntity</class>
        <class>rw.ac.auca.aura.infrastructure.persistence.entities.StudentCohortEntity</class>
        <class>rw.ac.auca.aura.infrastructure.persistence.entities.StudentEntity</class>
        <class>rw.ac.auca.aura.infrastructure.persistence.entities.CourseOfferingEntity</class>
        <class>rw.ac.auca.aura.infrastructure.persistence.entities.ResourceEntity</class>
        <class>rw.ac.auca.aura.infrastructure.persistence.entities.AcademicActivityEntity</class>
        <class>rw.ac.auca.aura.infrastructure.persistence.entities.AllocationRunEntity</class>
        <class>rw.ac.auca.aura.infrastructure.persistence.entities.AllocationDecisionEntity</class>
        <class>rw.ac.auca.aura.infrastructure.persistence.entities.AllocationEntity</class>
        <class>rw.ac.auca.aura.infrastructure.persistence.entities.AllocationResourceEntity</class>
        <class>rw.ac.auca.aura.infrastructure.persistence.entities.PolicyEntity</class>
        <class>rw.ac.auca.aura.infrastructure.persistence.entities.SystemMetadataEntity</class>
        <properties>
            <!-- Database Connection Settings -->
            <property name="jakarta.persistence.jdbc.driver" value="org.postgresql.Driver"/>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://postgres:5432/auradb"/>
            <property name="jakarta.persistence.jdbc.user" value="aura"/>
            <property name="jakarta.persistence.jdbc.password" value="aurapassword"/>

            <!-- Hibernate Settings -->
            <property name="hibernate.dialect" value="org.hibernate.dialect.PostgreSQLDialect"/>
            <property name="hibernate.hbm2ddl.auto" value="update"/>
            <property name="hibernate.show_sql" value="true"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
